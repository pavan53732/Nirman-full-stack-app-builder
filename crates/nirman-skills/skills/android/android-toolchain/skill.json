{
  "skillId": "android-toolchain",
  "name": "Android Toolchain",
  "description": "Prepares and verifies the Android toolchain: Node, package manager, Java, Gradle, Android SDK, platform tools, emulator or physical device, native dependencies, and signing. Authority for Android tooling is the Android toolchain authority (TA §49), independent of host-target build capability.",
  "version": "1.0.0",
  "scope": "BUILT_IN",
  "compatibleWorkerRoles": ["build_worker", "validation_worker"],
  "triggerConditions": [
    "target_platform_is_android",
    "android_build_or_device_validation_requested"
  ],
  "requiredTools": ["node", "package_manager", "java", "gradle", "android_sdk"],
  "requiredCapabilities": ["android_build"],
  "permissionRequests": [],
  "inputSchema": {
    "type": "object",
    "properties": {
      "environmentId": { "type": "string" },
      "stage": { "type": "string", "enum": ["toolchain_check", "build", "device_validation"] }
    },
    "required": ["environmentId", "stage"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "toolchainState": { "type": "object" },
      "buildGateResult": { "type": "string" },
      "deviceState": { "type": "string" }
    },
    "required": ["toolchainState", "buildGateResult"]
  },
  "sourcePath": "builtin/android/android-toolchain",
  "scanStatus": "CLEAN",
  "trustStatus": "TRUSTED",
  "enabled": true,
  "installedAt": 0,
  "lastUsedAt": null
}
