{
  "skillId": "environment-preflight",
  "name": "Environment Preflight",
  "description": "Identifies the host platform, target platform, and architecture; observes the toolchain, SDKs, runtimes, and native dependencies; classifies executable and validation capabilities through the deterministic EnvironmentCapabilityPlanner; and produces the durable environment record with its fingerprint. Runs before implementation. The model never sets or raises a capability state; this skill only reports the observed classification.",
  "version": "1.0.0",
  "scope": "BUILT_IN",
  "compatibleWorkerRoles": ["orchestrator", "build_worker", "validation_worker"],
  "triggerConditions": [
    "task_declares_target_platform",
    "before_first_build_or_validation_step",
    "environment_fingerprint_changed"
  ],
  "requiredTools": [],
  "requiredCapabilities": [],
  "permissionRequests": [],
  "inputSchema": {
    "type": "object",
    "properties": {
      "declaredTarget": { "type": "string" },
      "targetArchitecture": { "type": "string" }
    },
    "required": ["declaredTarget", "targetArchitecture"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "environmentId": { "type": "string" },
      "environmentFingerprint": { "type": "string" },
      "hostPlatform": { "type": "string" },
      "targetPlatform": { "type": "string" },
      "capabilityStates": { "type": "array" },
      "supersedes": { "type": ["string", "null"] }
    },
    "required": ["environmentId", "environmentFingerprint", "hostPlatform", "targetPlatform", "capabilityStates"]
  },
  "sourcePath": "builtin/environment/environment-preflight",
  "scanStatus": "CLEAN",
  "trustStatus": "TRUSTED",
  "enabled": true,
  "installedAt": 0,
  "lastUsedAt": null
}
